# Remplacez __N8N_DOMAIN__ par votre domaine (ex: rag-n8n.example.com)
# et __N8N_PORT__ par la valeur NGINX_N8N_PORT de infra/.env (ex: 15678)

server {
  listen 80;
  server_name __N8N_DOMAIN__;
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}

