# n8n reverse proxy — HTTP loopback (Certbot gèrera HTTPS)
server {
  listen 80;
  server_name ${N8N_EXTERNAL_DOMAIN};
  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  # --- Security headers ---
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
  add_header Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: http:;" always;

  proxy_connect_timeout 5s;
  proxy_buffering off;

  location / {
    ${N8N_BASIC_AUTH_DIRECTIVE}
    ${N8N_BASIC_AUTH_USER_FILE_DIRECTIVE}

    proxy_pass http://127.0.0.1:${NGINX_N8N_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $$http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $$host;
    proxy_set_header X-Real-IP $$remote_addr;
    proxy_set_header X-Forwarded-Proto $$scheme;
    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $$host;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    send_timeout 120s;
  }
}
