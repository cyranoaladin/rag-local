# Remplacez __UI_DOMAIN__ par votre domaine (ex: rag-ui.example.com)
# et __UI_PORT__ par la valeur NGINX_UI_PORT de infra/.env (ex: 18501)

server {
  listen 80;
  server_name __UI_DOMAIN__;
  # HTTP -> HTTPS (certbot créera les blocs SSL)
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}

