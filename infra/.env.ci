# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=ci.rag.local
N8N_EXTERNAL_DOMAIN=ci.automations.local
TZ=UTC

# --- Ports loopback pour Nginx ---
NGINX_N8N_PORT=15678
NGINX_UI_PORT=18501
NGINX_CLIENT_MAX_BODY_SIZE=16m
NGINX_UI_UPSTREAM=ui:8501
NGINX_N8N_UPSTREAM=n8n:5678
UI_BASIC_AUTH_DIRECTIVE=
UI_BASIC_AUTH_USER_FILE_DIRECTIVE=
N8N_BASIC_AUTH_DIRECTIVE=
N8N_BASIC_AUTH_USER_FILE_DIRECTIVE=

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui,automations,web

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- API Ingestor ---
INGEST_AUTH_TOKEN=ci_token_fort
INGEST_AUTH_HEADER=X-INGEST-TOKEN
INGESTOR_API_TOKEN=ci_token_fort
INGEST_API_TOKEN=ci_token_fort
INGESTOR_IP_ALLOWLIST=
METRICS_ENABLED=true
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
MAX_REMOTE_BYTES=26214400
CHROMA_REQUEST_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=60
UI_CHROMA_TIMEOUT=30
LOCAL_SOURCE_ROOT=/data/uploads
UI_WEBHOOK_TIMEOUT=10
UI_DEFAULT_K=4
UI_MAX_K=8

# --- Google Drive (dummy path for CI) ---
GOOGLE_APPLICATION_CREDENTIALS=/tmp/gdrive-service-account.json

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=ci_cle_forte
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=ciadmin
N8N_BASIC_AUTH_PASSWORD=ci_mdp_fort
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_FLAGS_METRICS=false
N8N_PUBLIC_API_DISABLED=true
N8N_TELEMETRY=false
METRICS_NAMESPACE=rag_local_ci

# --- UI ---
UI_SECRET_KEY=ci_ui_secret

# Autres variables selon vos besoins...
