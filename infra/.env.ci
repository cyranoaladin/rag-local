# Minimal CI environment (never expose publicly)
INGESTOR_API_TOKEN=devtoken
METRICS_ENABLED=true

# Multimodal disabled for CI smoke by default
MULTIMODAL_ENABLED=false
MULTIMODAL_DEPS=0
MM_PARSER_TIMEOUT=15
MM_MAX_CHARS_PER_CHUNK=8000
MM_CACHE_DIR=/data/mm-cache

# Nginx upstream defaults (not used in CI smoke)
NGINX_UI_UPSTREAM=ui:8501
NGINX_N8N_UPSTREAM=n8n:5678
NGINX_CLIENT_MAX_BODY_SIZE=16m
