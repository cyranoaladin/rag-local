# --- Domaines & Réseau ---
RAG_UI_EXTERNAL_DOMAIN=rag-ui.example.com
RAG_API_EXTERNAL_DOMAIN=rag-api.example.com
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_UI_PORT=18501
NGINX_API_PORT=8001
NGINX_CLIENT_MAX_BODY_SIZE=16m
NGINX_UI_UPSTREAM=ui:8501

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- API Ingestor ---
INGEST_AUTH_TOKEN=
INGESTOR_API_TOKEN=exemple_token_fort_a_remplacer
INGEST_API_TOKEN=
INGESTOR_IP_ALLOWLIST=
METRICS_ENABLED=true
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
MAX_REMOTE_BYTES=26214400
CHROMA_REQUEST_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=60
UI_CHROMA_TIMEOUT=30
LOCAL_SOURCE_ROOT=/data/uploads
UI_WEBHOOK_TIMEOUT=10
UI_DEFAULT_K=4
UI_MAX_K=8
UI_INGEST_AUTH_HEADER=Authorization
UI_INGEST_AUTH_BEARER_PREFIX=true

# --- UI ---
UI_SECRET_KEY=exemple_ui_secret_a_remplacer

# Autres variables selon vos besoins...
