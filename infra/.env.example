# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=rag.example.com
N8N_EXTERNAL_DOMAIN=automations.example.com
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_N8N_PORT=15678
NGINX_UI_PORT=18501
NGINX_CLIENT_MAX_BODY_SIZE=16m
NGINX_UI_UPSTREAM=ui:8501
NGINX_N8N_UPSTREAM=n8n:5678
UI_BASIC_AUTH_DIRECTIVE=
UI_BASIC_AUTH_USER_FILE_DIRECTIVE=
N8N_BASIC_AUTH_DIRECTIVE=
N8N_BASIC_AUTH_USER_FILE_DIRECTIVE=

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui,automations,web

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- API Ingestor ---
INGEST_AUTH_TOKEN=exemple_token_fort_a_remplacer
INGEST_AUTH_HEADER=X-INGEST-TOKEN
INGESTOR_API_TOKEN=exemple_token_fort_a_remplacer
INGEST_API_TOKEN=exemple_token_fort_a_remplacer
INGESTOR_IP_ALLOWLIST=
METRICS_ENABLED=false
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
MAX_REMOTE_BYTES=26214400
CHROMA_REQUEST_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=60
UI_CHROMA_TIMEOUT=30
LOCAL_SOURCE_ROOT=/data/uploads
UI_WEBHOOK_TIMEOUT=10
UI_DEFAULT_K=4
UI_MAX_K=8

# --- Google Drive (remplacez le chemin par le vrai fichier sur le VPS) ---
GOOGLE_APPLICATION_CREDENTIALS=/srv/rag-local/creds/gdrive-service-account.json

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=exemple_cle_forte_a_remplacer
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=exemple_mdp_fort_a_remplacer
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_FLAGS_METRICS=false
N8N_PUBLIC_API_DISABLED=true
N8N_TELEMETRY=false
METRICS_NAMESPACE=rag_local

# --- UI ---
UI_SECRET_KEY=exemple_ui_secret_a_remplacer

# Autres variables selon vos besoins...
