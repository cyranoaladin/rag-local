# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=rag.example.com
N8N_EXTERNAL_DOMAIN=automations.example.com
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_N8N_PORT=15678
NGINX_UI_PORT=18501
NGINX_CLIENT_MAX_BODY_SIZE=16m
UI_BASIC_AUTH_DIRECTIVE=
UI_BASIC_AUTH_USER_FILE_DIRECTIVE=
N8N_BASIC_AUTH_DIRECTIVE=
N8N_BASIC_AUTH_USER_FILE_DIRECTIVE=

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- API Ingestor ---
INGEST_AUTH_TOKEN=__GENERATE_STRONG_TOKEN__
INGEST_AUTH_HEADER=X-INGEST-TOKEN
INGESTOR_API_TOKEN=__CHANGE_ME__
INGESTOR_IP_ALLOWLIST=
MAX_REMOTE_BYTES=26214400
LOCAL_SOURCE_ROOT=/data/uploads

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=__CHANGE_ME__
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=__CHANGE_ME__
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_FLAGS_METRICS=false
N8N_PUBLIC_API_DISABLED=true
N8N_TELEMETRY=false
