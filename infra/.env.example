# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=rag-ui.nexusreussite.academy
N8N_EXTERNAL_DOMAIN=rag-n8n.nexusreussite.academy
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_N8N_PORT=15678
NGINX_UI_PORT=18501

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:3b-instruct

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=__REDACTED__
N8N_BASIC_AUTH_ACTIVE=__REDACTED__
N8N_BASIC_AUTH_USER=__REDACTED__
N8N_BASIC_AUTH_PASSWORD=__REDACTED__
