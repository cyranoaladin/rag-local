# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=rag-ui.nexusreussite.academy
N8N_EXTERNAL_DOMAIN=rag-n8n.nexusreussite.academy
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_N8N_PORT=15678
NGINX_UI_PORT=18501

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Compose profiles (par défaut: base RAG) ---
COMPOSE_PROFILES=db,llm,api,ui

# --- Modèles IA (CPU) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:3b-instruct

# --- Chroma ---
CHROMA_ENFORCE_EMBED_FUNCTION=false
CHROMA_RESET_COLLECTION_ON_CONFLICT=false

# --- Ingestor (multimodal) ---
INGESTOR_API_TOKEN=changeme
INGEST_IP_ALLOWLIST=127.0.0.1/32
INGEST_MAX_FILE_MB=20
MULTIMODAL_ENABLED=true
MULTIMODAL_PARSER=raganything
MM_MAX_CHARS_PER_CHUNK=8000
MM_CACHE_DIR=/data/cache
MM_ALLOWED_SUFFIXES=.pdf,.png,.jpg,.jpeg
MM_PARSER_TIMEOUT=15
MULTIMODAL_OFFICE_ENABLED=false
OCR_ENABLED=false
# Build-time toggle (profil multimodal uniquement)
MULTIMODAL_DEPS=0

# Tests / smoke locaux
INGEST_BASE_URL=http://127.0.0.1:8001

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=__REDACTED__
N8N_BASIC_AUTH_ACTIVE=__REDACTED__
N8N_BASIC_AUTH_USER=__REDACTED__
N8N_BASIC_AUTH_PASSWORD=__REDACTED__
