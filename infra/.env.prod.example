# --- Domaines & Réseau ---
RAG_EXTERNAL_DOMAIN=rag-ui.example.com
N8N_EXTERNAL_DOMAIN=rag-n8n.example.com
TZ=Africa/Tunis

# --- Ports loopback pour Nginx ---
NGINX_UI_PORT=18501
NGINX_N8N_PORT=15678

# --- Ports internes (ne pas exposer publiquement) ---
CHROMA_PORT=8000
OLLAMA_PORT=11434
N8N_PORT=5678
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Modèles IA (Ollama) ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest

# --- Sécurité n8n ---
N8N_ENCRYPTION_KEY=remplacer-par-une-cle-hexadecimale-de-64-caracteres
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=nexus
N8N_BASIC_AUTH_PASSWORD=definir-un-mot-de-passe-robuste
