# Production environment template for rag-local (edit before use)
# Copy this file to infra/.env and replace placeholder values.

# --- Domains & time zone ---
RAG_UI_EXTERNAL_DOMAIN=rag-ui.example.com
RAG_API_EXTERNAL_DOMAIN=rag-api.example.com
TZ=Europe/Paris

# --- Secrets ---
INGESTOR_API_TOKEN=replace_with_random_hex_64
INGEST_AUTH_TOKEN=replace_with_random_hex_64

# --- Networking & ports ---
COMPOSE_PROFILES=db,llm,api,ui
CHROMA_PORT=8000
OLLAMA_PORT=11434
STREAMLIT_PORT=8501
INGESTOR_PORT=8001

# --- Reverse proxy (loopback mappings) ---
NGINX_UI_PORT=18501
NGINX_API_PORT=8001
NGINX_CLIENT_MAX_BODY_SIZE=32m
NGINX_UI_UPSTREAM=ui:8501

# --- Ollama models ---
EMBED_MODEL=nomic-embed-text
SMALL_LLM=llama3.2:latest
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Ingest service configuration ---
INGEST_BASE_URL=http://ingestor:8001
INGEST_AUTH_HEADER=Authorization
INGESTOR_IP_ALLOWLIST=
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
MAX_REMOTE_BYTES=26214400
METRICS_ENABLED=true
METRICS_NAMESPACE=rag_local
CHROMA_REQUEST_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=60

# --- UI ingestion (API calls from Streamlit) ---
INGEST_API_BASE=http://ingestor:8001
INGEST_API_TOKEN=replace_with_random_hex_64
UI_INGEST_AUTH_HEADER=Authorization
UI_INGEST_AUTH_BEARER_PREFIX=true
UI_DEFAULT_K=4
UI_MAX_K=8
UI_WEBHOOK_TIMEOUT=10
UI_CHROMA_TIMEOUT=30

# --- Multimodal ingest knobs ---
MULTIMODAL_ENABLED=false
MM_PARSER_TIMEOUT=30
MM_MAX_CHARS_PER_CHUNK=1200
MM_CACHE_DIR=/data/mm-cache

# --- Backups & observability ---
PROMETHEUS_SCRAPE_USER=prom_user
PROMETHEUS_SCRAPE_PASSWORD=prom_password

# --- Local source roots (mounted volumes) ---
LOCAL_SOURCE_ROOT=/data/uploads
